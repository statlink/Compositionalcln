x <- matrix( rnorm(150 * 10), ncol = 10 )
prior <- iris[, 4]
y <- as.matrix(iris[, 1:3])
y <- y / rowSums(y)
ind <- sample(150, 10)
for ( k in ind )  y[k, sample(3, 1)] <- 0
y <- y / rowSums(y)
mod <- cln.condregs(y, x, prior = prior)
