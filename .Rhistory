y <- as.matrix(iris[1:50, 1:3])
y <- y / rowSums(y)
ind <- sample(50, 10)
for ( k in ind )  y[k, sample(3, 1)] <- 0
y <- y / rowSums(y)
mod <- cln.mle(y)
m <- mod$m
S <- mod$S
cln.cr(y, m, S, ploty = FALSE)
cln.bcr(y,R=500)
cln.bcr(y,R=500,ploty=F)
